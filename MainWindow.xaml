
<Window x:Class="WheelBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelBridge" Height="800" Width="1220"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0A101B" Foreground="#EAF1FA"
        FontFamily="Segoe UI"
        Loaded="MainWindow_Loaded" Closed="MainWindow_Closed">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A5B4C8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Border Width="3" Margin="0,8,0,8"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding BorderBrush}"
                                        CornerRadius="2"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#192A40"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#203B5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#223A59"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="BorderBrush" Value="#35577F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#315783"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#609BEB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1B304B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#347CF6"/>
            <Setter Property="BorderBrush" Value="#5794FF"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#482A39"/>
            <Setter Property="BorderBrush" Value="#744054"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111C2C"/>
            <Setter Property="BorderBrush" Value="#263A54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A2B9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1523"/>
            <Setter Property="Foreground" Value="#EAF1FA"/>
            <Setter Property="BorderBrush" Value="#344A67"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#3478F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#111111"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#DCEAFF"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#C5DCFF"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D4E5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#25364D"/>
            <Setter Property="Foreground" Value="#4A91F5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#101A29"
                BorderBrush="#263A54"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="11" Background="#347CF6">
                        <TextBlock Text="W" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="WHEELBRIDGE" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="STEERING INPUT SYSTEM" FontSize="9" Foreground="#8294AC"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#1A2A40"
                        BorderBrush="#2C4565" BorderThickness="1"
                        CornerRadius="9" Padding="12,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS 11  ·  PREVIEW"
                               FontSize="10" Foreground="#8DB8FF"/>
                </Border>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0D1623"
                BorderBrush="#263A54" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MENU PRINCIPALE" FontSize="9"
                               FontWeight="Bold" Foreground="#657891"
                               Margin="11,0,0,13"/>
                    <Button x:Name="DashboardNavButton" Content="◈    Dashboard"
                            Style="{StaticResource NavButton}" Click="Dashboard_Click"/>
                    <Button x:Name="DevicesNavButton" Content="◉    Dispositivi"
                            Style="{StaticResource NavButton}" Click="Devices_Click"/>
                    <Button x:Name="MappingNavButton" Content="⌘    Mappatura"
                            Style="{StaticResource NavButton}" Click="Mapping_Click"/>
                    <Button x:Name="ProfilesNavButton" Content="▤    Profili"
                            Style="{StaticResource NavButton}" Click="Profiles_Click"/>
                    <Button x:Name="SettingsNavButton" Content="⚙    Impostazioni"
                            Style="{StaticResource NavButton}" Click="Settings_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#131F30"
                        BorderBrush="#263A54" BorderThickness="1"
                        CornerRadius="12" Padding="13" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="VERSIONE" FontSize="9" Foreground="#73869F"/>
                        <TextBlock Text="WheelBridge 1.1" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,5,0,2"/>
                        <TextBlock Text="Configurazione locale" FontSize="10"
                                   Foreground="#73869F"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- PAGE HOST -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- DASHBOARD -->
            <ScrollViewer x:Name="DashboardPage" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Panoramica del tuo sistema di controllo."
                               Style="{StaticResource MutedText}" Margin="0,5,0,24"/>

                    <Grid Margin="0,0,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="DISPOSITIVO FISICO" FontSize="10" Foreground="#91A2B9"/>
                                <TextBlock Text="Dispositivo DirectInput" FontSize="17"
                                           FontWeight="SemiBold" Margin="0,12,0,7"/>
                                <TextBlock x:Name="DashboardDeviceStatus"
                                           Text="Non collegato" FontSize="11" Foreground="#EAB866"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="USCITA GAMEPAD" FontSize="10" Foreground="#91A2B9"/>
                                <TextBlock Text="Xbox 360 virtuale" FontSize="17"
                                           FontWeight="SemiBold" Margin="0,12,0,7"/>
                                <TextBlock Text="Driver non ancora configurato"
                                           FontSize="11" Foreground="#EAB866"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PROFILO ATTIVO" FontSize="10" Foreground="#91A2B9"/>
                                <TextBlock x:Name="DashboardProfileName" Text="Predefinito"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,12,0,7"/>
                                <TextBlock Text="Configurazione locale"
                                           FontSize="11" Foreground="#78D8AB"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MONITOR INPUT MAPPATI" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Valori normalizzati in base alla mappatura selezionata."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="STERZO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DashboardSteeringBar" Grid.Column="1"
                                             Style="{StaticResource Meter}" Minimum="0" Maximum="100"
                                             Value="50" VerticalAlignment="Center" Margin="12,0"/>
                                <TextBlock x:Name="DashboardSteeringValue" Grid.Column="2"
                                           Text="0%" Foreground="#A9C9FF"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACCELERATORE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DashboardThrottleBar" Grid.Column="1"
                                             Style="{StaticResource Meter}" Minimum="0" Maximum="100"
                                             Value="0" VerticalAlignment="Center" Margin="12,0"
                                             Foreground="#53C995"/>
                                <TextBlock x:Name="DashboardThrottleValue" Grid.Column="2"
                                           Text="0%" Foreground="#8DE2BB"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FRENO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DashboardBrakeBar" Grid.Column="1"
                                             Style="{StaticResource Meter}" Minimum="0" Maximum="100"
                                             Value="0" VerticalAlignment="Center" Margin="12,0"
                                             Foreground="#E29A65"/>
                                <TextBlock x:Name="DashboardBrakeValue" Grid.Column="2"
                                           Text="0%" Foreground="#F0B48D"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="DashboardInputStatus"
                                       Text="Collega un dispositivo dalla sezione Dispositivi."
                                       Foreground="#8295AE" FontSize="11" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#14243A" BorderBrush="#29466C"
                            BorderThickness="1" CornerRadius="13" Padding="17">
                        <StackPanel>
                            <TextBlock Text="PROSSIMO PASSAGGIO"
                                       Foreground="#83B2FF" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="Dopo aver configurato e verificato gli input, collegheremo l'uscita al controller Xbox virtuale."
                                       TextWrapping="Wrap" Foreground="#D0DCEC"
                                       FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- DEVICES -->
            <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="Dispositivi" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Rileva, seleziona e monitora il volante."
                               Style="{StaticResource MutedText}" Margin="0,5,0,24"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DISPOSITIVI RILEVATI" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Scegli il dispositivo DirectInput da utilizzare."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,14"/>
                            <ComboBox x:Name="DeviceComboBox" DisplayMemberPath="Name"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="CERCA DISPOSITIVI" Style="{StaticResource ActionButton}" Click="RefreshDevices_Click"/>
                                <Button Content="COLLEGA" Style="{StaticResource PrimaryButton}" Click="ConnectDevice_Click"/>
                                <Button Content="DISCONNETTI" Style="{StaticResource DangerButton}" Click="DisconnectDevice_Click" Margin="0"/>
                            </WrapPanel>
                            <TextBlock x:Name="DeviceStatusText" Text="In attesa di rilevamento."
                                       Foreground="#EAB866" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MONITOR DIRECTINPUT" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Valori grezzi restituiti dal dispositivo selezionato."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
                            <UniformGrid Columns="2">
                                <TextBlock x:Name="AxisXText" Text="Asse X: —" Margin="0,7"/>
                                <TextBlock x:Name="AxisYText" Text="Asse Y: —" Margin="0,7"/>
                                <TextBlock x:Name="AxisZText" Text="Asse Z: —" Margin="0,7"/>
                                <TextBlock x:Name="AxisRXText" Text="Rotazione X: —" Margin="0,7"/>
                                <TextBlock x:Name="AxisRYText" Text="Rotazione Y: —" Margin="0,7"/>
                                <TextBlock x:Name="AxisRZText" Text="Rotazione Z: —" Margin="0,7"/>
                                <TextBlock x:Name="Slider0Text" Text="Slider 1: non esposto" Margin="0,7"/>
                                <TextBlock x:Name="Slider1Text" Text="Slider 2: non esposto" Margin="0,7"/>
                            </UniformGrid>
                            <TextBlock Text="PULSANTI PREMUTI" FontWeight="Bold"
                                       FontSize="11" Margin="0,17,0,7"/>
                            <Border Background="#0C1625" BorderBrush="#2A405C"
                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock x:Name="ButtonsText" Text="Nessun pulsante rilevato."
                                           Foreground="#8DB8FF" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- MAPPING -->
            <ScrollViewer x:Name="MappingPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="Mappatura" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Scegli quali assi e pulsanti del volante associare ai comandi del gamepad."
                               Style="{StaticResource MutedText}" Margin="0,5,0,24"/>

                    <!-- ASSI -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ASSOCIAZIONE DEGLI ASSI" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Seleziona l'asse fisico da usare per ogni comando."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Sterzo" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SteeringAxisCombo" Grid.Column="1" Margin="0,3,10,8"/>
                                <Button Grid.Column="2" Content="RILEVA" Tag="Steering"
                                        Style="{StaticResource ActionButton}" Click="CaptureAxis_Click"
                                        Margin="0,3,10,8" Padding="12,7"/>
                                <CheckBox x:Name="InvertSteeringCheck" Grid.Column="3"
                                          Content="Inverti" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="Acceleratore" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ThrottleAxisCombo" Grid.Row="1" Grid.Column="1" Margin="0,3,10,8"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="RILEVA" Tag="Throttle"
                                        Style="{StaticResource ActionButton}" Click="CaptureAxis_Click"
                                        Margin="0,3,10,8" Padding="12,7"/>
                                <CheckBox x:Name="InvertThrottleCheck" Grid.Row="1" Grid.Column="3"
                                          Content="Inverti" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="Freno" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="BrakeAxisCombo" Grid.Row="2" Grid.Column="1" Margin="0,3,10,0"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="RILEVA" Tag="Brake"
                                        Style="{StaticResource ActionButton}" Click="CaptureAxis_Click"
                                        Margin="0,3,10,0" Padding="12,7"/>
                                <CheckBox x:Name="InvertBrakeCheck" Grid.Row="2" Grid.Column="3"
                                          Content="Inverti" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="AxisCaptureStatusText"
                                       Text="Collega il volante, poi premi RILEVA e muovi soltanto il comando richiesto."
                                       Foreground="#8295AE" FontSize="11" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- SENSIBILITA MAPPATURA -->
                            <Border Background="#101D2E" BorderBrush="#29415F"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="SENSIBILITÀ DELLO STERZO"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#DCE9FA"/>
                                    <TextBlock Text="Regola quanto rapidamente risponde il volante. Valori più alti rendono lo sterzo più reattivo."
                                               Foreground="#8295AE" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,5,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MappingSensitivitySlider"
                                                Minimum="50" Maximum="1000"
                                                Value="400" TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="MappingSensitivitySlider_ValueChanged"/>
                                        <TextBlock x:Name="MappingSensitivityValueText"
                                                   Grid.Column="1" Text="400%"
                                                   Foreground="#8DB8FF"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- MONITOR ASSI -->
                            <Border Background="#101D2E" BorderBrush="#29415F"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="MONITOR ASSI IN TEMPO REALE"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#DCE9FA" Margin="0,0,0,14"/>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center">
                                        <StackPanel Width="105" HorizontalAlignment="Center">
                                            <ProgressBar x:Name="MappingSteeringMeter"
                                                         Orientation="Vertical" Width="24"
                                                         Height="112" Minimum="0" Maximum="100"
                                                         Value="50" Foreground="#4A91F5"
                                                         Background="#263A53" BorderThickness="0"/>
                                            <TextBlock Text="Sterzo" Foreground="#AFCFFF"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                            <TextBlock x:Name="MappingSteeringValue" Text="0%"
                                                       Foreground="#DCE9FA" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="105" HorizontalAlignment="Center">
                                            <ProgressBar x:Name="MappingBrakeMeter"
                                                         Orientation="Vertical" Width="24"
                                                         Height="112" Minimum="0" Maximum="100"
                                                         Value="0" Foreground="#E29A65"
                                                         Background="#263A53" BorderThickness="0"/>
                                            <TextBlock Text="Freno" Foreground="#F0B48D"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                            <TextBlock x:Name="MappingBrakeValue" Text="0%"
                                                       Foreground="#DCE9FA" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="105" HorizontalAlignment="Center">
                                            <ProgressBar x:Name="MappingThrottleMeter"
                                                         Orientation="Vertical" Width="24"
                                                         Height="112" Minimum="0" Maximum="100"
                                                         Value="0" Foreground="#53C995"
                                                         Background="#263A53" BorderThickness="0"/>
                                            <TextBlock Text="Acceleratore" Foreground="#8DE2BB"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                            <TextBlock x:Name="MappingThrottleValue" Text="0%"
                                                       Foreground="#DCE9FA" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Button Content="APPLICA MAPPATURA"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ApplyMapping_Click"
                                    HorizontalAlignment="Left" Margin="0,18,0,0"/>
