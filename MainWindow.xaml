                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROFILI SALVATI" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Seleziona un profilo per caricarlo o eliminarlo."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,12"/>
                            <ListBox x:Name="ProfilesListBox" MinHeight="130" MaxHeight="220"
                                     Background="#0C1523" Foreground="#EAF1FA"
                                     BorderBrush="#344A67" BorderThickness="1" Padding="5"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="CARICA" Style="{StaticResource PrimaryButton}" Click="LoadProfile_Click"/>
                                <Button Content="ELIMINA" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="Impostazioni" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Regola la risposta del volante e salva le preferenze locali."
                               Style="{StaticResource MutedText}" Margin="0,5,0,24"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SENSIBILITÀ DELLO STERZO" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Modifica quanto rapidamente reagisce il valore dello sterzo."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,14"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SensitivitySlider"
                                        Minimum="50" Maximum="1000"
                                        Value="400" TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="SensitivitySlider_ValueChanged"/>
                                <TextBlock x:Name="SensitivityValueText"
                                           Grid.Column="1" Text="400%"
                                           Foreground="#8DB8FF" FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ZONA MORTA" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Riduce piccoli movimenti involontari vicino al centro dello sterzo e all'inizio della corsa dei pedali."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,14"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="30"
                                        Value="5" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="DeadzoneSlider_ValueChanged"/>
                                <TextBlock x:Name="DeadzoneValueText" Grid.Column="1"
                                           Text="5%" Foreground="#8DB8FF"
                                           FontWeight="Bold" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PREFERENZE" FontSize="14" FontWeight="Bold"/>
                            <CheckBox x:Name="ShowRawValuesCheck"
                                      Content="Mostra i valori DirectInput nella schermata Dispositivi"
                                      IsChecked="True"/>
                            <TextBlock Text="Questa opzione controlla solo la visualizzazione dei valori grezzi; non cambia il collegamento al volante."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="SALVA IMPOSTAZIONI"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveSettings_Click"
                            HorizontalAlignment="Left"/>
                    <TextBlock x:Name="SettingsStatusText"
                               Text="Le impostazioni sono locali a questo PC."
                               Foreground="#8295AE" FontSize="11"
                               Margin="0,10,0,20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
